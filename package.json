{
  "name": "red-sky",
  "version": "0.3.0-beta",
  "description": "Red Sky — Grok Bot–style local AI teammates on your desktop. Runs the OpenCode CLI on your machine; not Ollama.",
  "license": "MIT",
  "author": "Muditya Raghav (https://github.com/0xMudit)",
  "homepage": "https://github.com/0xMudit/redsky-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xMudit/redsky-agents.git"
  },
  "bugs": {
    "url": "https://github.com/0xMudit/redsky-agents/issues"
  },
  "keywords": [
    "ai-agents",
    "autonomous-agents",
    "opencode",
    "electron",
    "desktop-app",
    "local-first",
    "react",
    "typescript"
  ],
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node build.mjs && vite build --config vite.config.ts",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build:icons": "node scripts/build-icons.mjs",
    "build:test": "node scripts/build-tests.mjs",
    "test": "npm run build:test && node --test build-tests/suite.test.cjs",
    "dist": "npm run build:icons && npm run build && electron-builder",
    "dist:win": "npm run build:icons && npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build:icons && npm run build && electron-builder --mac --x64 --arm64",
    "dist:linux": "npm run build:icons && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "@fontsource/antic": "^5.3.0",
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.4",
    "electron-updater": "^6.3.9",
    "ionicons": "^8.1.0",
    "lucide-react": "^1.56.0",
    "marked": "^15.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "sharp@0.33.5": true
  }
}
