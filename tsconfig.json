{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./renderer/src/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "electron/**/*.d.ts",
    "renderer/src/**/*.ts",
    "renderer/src/**/*.tsx",
    "shared/**/*.ts",
    "test/**/*.ts"
  ]
}